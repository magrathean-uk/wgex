#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Opt-in repo hook (see CONTRIBUTING.md): blocks the push unless `just check` passes.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v just >/dev/null 2>&1; then
  echo "pre-push: just not found; run Tools/doctor/doctor.sh" >&2
  exit 1
fi
exec just check
