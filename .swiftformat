# swiftformat house style (plan 03 §9)
--swiftversion 6.4
--indent 4
--self remove
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--stripunusedargs closure-only
--header ignore
--exclude .build,**/.build,**/.swiftpm,DerivedData,Tools/lint/tests,Vendor,Engine/go/vendor,Design/.work,Design/.taste-skill
