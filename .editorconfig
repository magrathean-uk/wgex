root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
# shfmt reads these: equivalent to `shfmt -i 2 -ci`
indent_size = 2
switch_case_indent = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[{justfile,*.just}]
indent_size = 4

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
