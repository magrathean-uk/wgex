#!/bin/bash
# SPDX-License-Identifier: MIT
# Only ordinary files and pipes. Never delegates to a system packet-filter tool.
# Each invocation consumes replies/<n>.{stdout,stderr,status,delay,bulk,control}.
# The script is copied into a private per-test directory, alongside its control files.
set -eu
printf 'No ALTQ support in kernel\nALTQ related functions disabled\n' >&2
fixture_dir="${0%/*}"
call=1
if [[ -f "$fixture_dir/count" ]]; then
  read -r call <"$fixture_dir/count"
  call=$((call + 1))
fi
printf '%s\n' "$call" >"$fixture_dir/count"
call_dir="$fixture_dir/call-$call"
/bin/mkdir -p "$call_dir"
printf '%s\n' "$@" >"$call_dir/argv"
/usr/bin/env >"$call_dir/environment"
if [[ -f "$fixture_dir/durable" ]]; then /bin/cat "$fixture_dir/durable" >"$call_dir/durable"; fi
/bin/cat >"$call_dir/stdin"
reply="$fixture_dir/replies/$call"
if [[ -f "$reply.delay" ]]; then
  read -r delay <"$reply.delay"
  exec /bin/sleep "$delay"
fi
if [[ -p "$reply.control" ]]; then
  # The parent holds the FIFO open. Only this shell waits; no sleeping descendants survive a kill.
  printf '%s %s\n' "$$" "$PPID" >"$call_dir/ready"
  printf 'ready\n'
  if ! IFS= read -r -t 120 control <"$reply.control"; then
    printf 'expired\n' >"$call_dir/watchdog"
    exit 124
  fi
  [[ "$control" == complete ]] || exit 125
fi
if [[ -f "$reply.bulk" ]]; then
  # More than pipe capacity on both outputs; catches serial-pipe deadlocks.
  for ((i = 0; i < 4096; i++)); do
    printf '%064d\n' 0
    printf '%064d\n' 0 >&2
  done
fi
if [[ -f "$reply.stdout" ]]; then /bin/cat "$reply.stdout"; fi
if [[ -f "$reply.stderr" ]]; then /bin/cat "$reply.stderr" >&2; fi
status=0
if [[ -f "$reply.status" ]]; then read -r status <"$reply.status"; fi
exit "$status"
